# ChatApp Real Mode Configuration (template)
# Copy to real.env (same directory) — real.env is gitignored deployment config.
# cp real.env.example real.env

# LLM Service Configuration
# For local Ollama: http://127.0.0.1:11434
# For remote OpenAI-compatible API: https://your-api-endpoint/v1
# NOTE: explicit IPv4 — `localhost` may resolve to ::1 and miss an IPv4-bound server
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Model name (must match a model available at the above endpoint)
OLLAMA_MODEL=qwen3.5:9b

# Enable thinking/reasoning output (set to "false" to disable, case-insensitive)
OLLAMA_THINKING_ENABLED=true

# Keep models resident between requests (Ollama default 5m evicts models when
# a second model loads — e.g. the ASR model below). Ollama extension, optional.
OLLAMA_KEEP_ALIVE=30m

# Voice-to-text model — must be an audio-capable model on the endpoint above
OLLAMA_ASR_MODEL=lfm3-audio:latest

# API key (required by some providers, use "ollama" for local Ollama)
OPENAI_API_KEY=ollama

# Server Configuration (see comment on OLLAMA_BASE_URL for the IPv4 note)
HOST=127.0.0.1
PORT=3000
