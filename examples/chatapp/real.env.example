# ChatApp Real Mode Configuration
# All deployment-related config must be in this file, not hardcoded in source code

# LLM Service Configuration
# For local Ollama: http://localhost:11434
# For remote OpenAI-compatible API: https://your-api-endpoint/v1
OLLAMA_BASE_URL=http://localhost:11434

# Model name (must match a model available at the above endpoint)
OLLAMA_MODEL=qwen3.5:9b

# Enable thinking/reasoning output (set to "false" to disable, case-insensitive)
OLLAMA_THINKING_ENABLED=true

# API key (required by some providers, use "ollama" for local Ollama)
OPENAI_API_KEY=ollama

# Server Configuration
HOST=localhost
PORT=3000
