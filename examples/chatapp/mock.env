# ChatApp Mock Mode Configuration
# All deployment-related config must be in this file, not hardcoded in source code

# Mode
MODE=mock

# Server Configuration
# 127.0.0.1 (explicit IPv4) instead of `localhost`: on Node >= 17 `localhost`
# may resolve/bind to ::1 only, which breaks clients that dial 127.0.0.1
# (Playwright health checks, vite proxy) — the "connection refused on Windows" class.
HOST=127.0.0.1
PORT=3001
