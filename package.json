{
  "name": "ai-chatbot-frontend",
  "version": "1.0.0",
  "description": "AI Chatbot Frontend - Vue 3 + Element Plus + TypeScript component library",
  "type": "module",
  "main": "./dist/ai-chatbot.umd.js",
  "module": "./dist/ai-chatbot.es.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/ai-chatbot.es.js",
      "require": "./dist/ai-chatbot.umd.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "dev": "vite",
    "dev:iframe": "vite --config vite.config.iframe.ts",
    "build": "vite build",
    "build:lib": "vite build --config vite.config.lib.ts",
    "build:iframe": "vite build --config vite.config.iframe.ts",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "lint:check": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --ignore-path .gitignore",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:chatapp": "playwright test --project=chatapp",
    "test:e2e:lib": "playwright test --project=lib"
  },
  "dependencies": {
    "dompurify": "3.3.2",
    "element-plus": "^2.5.0",
    "highlight.js": "11.11.1",
    "lucide-vue-next": "1.0.0",
    "markdown-it": "14.1.1",
    "vue": "^3.4.0"
  },
  "peerDependencies": {
    "@vue-office/docx": ">=1.6.0",
    "@vue-office/excel": ">=1.7.0",
    "@vue-office/pdf": ">=1.6.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@testing-library/vue": "^8.1.0",
    "@types/dompurify": "3.0.5",
    "@types/markdown-it": "14.1.2",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/coverage-v8": "4.1.8",
    "@vue/eslint-config-prettier": "^9.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^9.20.0",
    "happy-dom": "^20.6.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.2.0",
    "sass": "^1.69.0",
    "terser": "^5.46.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "4.1.8",
    "vue-tsc": "2.2.12"
  },
  "keywords": [
    "chatbot",
    "ai",
    "vue3",
    "vue",
    "typescript",
    "element-plus",
    "component-library",
    "ui-components",
    "streaming",
    "iframe",
    "responsive",
    "conversation",
    "assistant"
  ],
  "author": "AI ChatBot Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dliting/chatbot-front.git"
  },
  "bugs": {
    "url": "https://github.com/dliting/chatbot-front/issues"
  },
  "homepage": "https://github.com/dliting/chatbot-front#readme",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
